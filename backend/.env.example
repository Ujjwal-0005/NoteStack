# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/NoteStack?retryWrites=true&w=majority

# Port for backend server
PORT=5000

# JSON Web Token secret key
JWT_SECRET=your_jwt_secret_key_here

# Allowed CORS client origin(s), comma-separated
CLIENT_URL=http://localhost:5173
